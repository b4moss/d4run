steps:
  # Build Docker image (switch tag for stg/prd)
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'build'
      - '--platform'
      - 'linux/amd64'
      - '-t'
      - 'gcr.io/$PROJECT_ID/{project-name}:${_TAG}'
      - '-f'
      - 'docker/app/Dockerfile.prod'
      - '.'

  # Push image to Google Container Registry
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - 'gcr.io/$PROJECT_ID/{project-name}:${_TAG}'

images:
  - 'gcr.io/$PROJECT_ID/{project-name}:${_TAG}'

options:
  machineType: 'E2_HIGHCPU_8'
  # Use GCS logs (specify logsBucket when using serviceAccount)
  logging: GCS_ONLY
  defaultLogsBucketBehavior: REGIONAL_USER_OWNED_BUCKET

# Explicitly specify service account
serviceAccount: 'projects/$PROJECT_ID/serviceAccounts/{project-name}@$PROJECT_ID.iam.gserviceaccount.com'

# Explicitly specify GCS logs bucket (for gcloud builds submit streaming)
logsBucket: 'gs://${PROJECT_ID}_cloudbuild'

# Substitutions
substitutions:
  # Image tag: staging-{version} / production-{version}
  _TAG: 'staging'

