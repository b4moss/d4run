  frontend:
    profiles: ["dev"]
    build:
      context: .
      dockerfile: docker/frontend/nuxt/Dockerfile.dev
    image: {project-name}-frontend-dev
    container_name: {project-name}-frontend-dev
    working_dir: /app
    volumes:
      - ./frontend:/app
    environment:
      - NODE_ENV=development
    command:
      - sh
      - -lc
      - |
          if [ ! -f package.json ]; then cat > package.json <<'PKG'
          {
            "name": "frontend",
            "private": true,
            "type": "module",
            "scripts": {
              "dev": "nuxt dev",
              "build": "nuxt build",
              "start": "nuxt start",
              "generate": "nuxt generate"
            },
            "devDependencies": { "nuxt": "latest" }
          }
          PKG
          fi
          if [ ! -f nuxt.config.ts ] && [ ! -f nuxt.config.js ]; then printf "export default defineNuxtConfig({})\n" > nuxt.config.ts; fi
          if [ ! -f app.vue ]; then mkdir -p pages; printf "<template>\n  <div>Nuxt 3 is ready.</div>\n</template>\n" > app.vue; fi
          npm i || true
          npm run dev -- --host 0.0.0.0 --port 3000
    ports:
      - "3000:3000"
