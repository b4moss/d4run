#!/bin/bash
set -euo pipefail
GITEA_URL="${GITEA_URL:-${1:-}}"; GITEA_OWNER="${GITEA_OWNER:-${2:-}}"; GITEA_REPO="${GITEA_REPO:-${3:-}}"; GITEA_TOKEN="${GITEA_TOKEN:-${4:-}}"
[ -z "$GITEA_URL" ]||[ -z "$GITEA_OWNER" ]||[ -z "$GITEA_REPO" ]||[ -z "$GITEA_TOKEN" ]&&{ echo "Usage: $0 <URL> <OWNER> <REPO> <TOKEN>" >&2; exit 1; }
API_BASE="${GITEA_URL}/api/v1"
set_secret(){ local name=$1; local value=$2; curl -s -X DELETE -H "Authorization: token $GITEA_TOKEN" -H "Content-Type: application/json" "${API_BASE}/repos/${GITEA_OWNER}/${GITEA_REPO}/actions/secrets/${name}" >/dev/null 2>&1 || true; curl -s -X PUT -H "Authorization: token $GITEA_TOKEN" -H "Content-Type: application/json" -d "{\"data\":\"$(echo -n "$value" | base64 | tr -d '\n')\"}" "${API_BASE}/repos/${GITEA_OWNER}/${GITEA_REPO}/actions/secrets/${name}" >/dev/null; }
[ -f .env ] && while IFS='=' read -r k v || [ -n "$k" ]; do [[ "$k" =~ ^#|^$ ]] && continue; v=$(echo "$v"|sed "s/^['"]//;s/['"]$//"); case "$k" in GOOGLE_CLOUD_PROJECT) set_secret GCP_PROJECT_ID "$v";; CLOUDRUN_API_KEY) set_secret CLOUDRUN_API_KEY "$v";; esac; done < .env
